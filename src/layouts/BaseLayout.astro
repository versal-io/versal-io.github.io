---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "Versal — a Valkey-compatible data store rewritten in Rust, running in your browser via WebAssembly.",
  currentPath = Astro.url.pathname,
} = Astro.props;

const navItems = [
  { href: "/", label: "Shell" },
  { href: "/blog/", label: "Blog" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <div class="brand-wrap">
        <a class="brand" href="/">versal</a>
        <span class="brand-tagline">valkey, rewritten in rust</span>
      </div>
      <div class="topbar-actions">
        {
          navItems.map((item) => (
            <a
              class="nav-link"
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <span class="version-badge">wasm32 · preview</span>
        <a
          class="gh-link"
          href="https://github.com/versal-io"
          target="_blank"
          rel="noopener"
        >
          GitHub ↗
        </a>
      </div>
    </header>
    <slot />
  </body>
</html>
